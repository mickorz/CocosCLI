{
  "name": "cocoscli",
  "version": "0.0.1",
  "description": "Cocos Creator 3.7.x 项目命令行工具",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cocoscli": "./dist/index.js",
    "cdp-cli": "./dist/cdp-cli-bin.js"
  },
  "files": [
    "dist",
    "vendor"
  ],
  "scripts": {
    "setup": "node scripts/setup-deps.mjs",
    "build:deps": "node scripts/build-deps.mjs",
    "prepare-package": "node scripts/prepare-package.mjs",
    "prepack": "npm run build && npm run build:deps && npm run prepare-package",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "cocos",
    "cocos-creator",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
